# Inspection integration upstream API
# Keep these values beside the integration instead of the framework root .env.
INSPECTION_API_BASE_URL=
INSPECTION_API_TIMEOUT_SECONDS=30
INSPECTION_TIMEZONE=Asia/Shanghai
INSPECTION_PLAN_DETAIL_URL=
INSPECTION_DRONE_LIST_URL=
INSPECTION_FLIGHT_WORKER_LIST_URL=
INSPECTION_TEXT_TO_SQL_DATASOURCE=inspection_mysql

# Inspection-owned AllCore upstream authentication.
INSPECTION_ALLCORE_AUTH_TOKEN=
INSPECTION_ALLCORE_AUTH_LOGIN_URL=http://10.10.1.187:8000/api/allcore-auth/oauth/token
INSPECTION_ALLCORE_AUTH_USERNAME=
INSPECTION_ALLCORE_AUTH_PASSWORD=
INSPECTION_ALLCORE_AUTH_GRANT_TYPE=password
INSPECTION_ALLCORE_AUTH_TYPE=account
INSPECTION_ALLCORE_AUTH_SCOPE=all
INSPECTION_ALLCORE_BASIC_AUTH=
INSPECTION_ALLCORE_TENANT_ID=
INSPECTION_ALLCORE_TOKEN_TTL_SECONDS=64800
INSPECTION_ALLCORE_TOKEN_REFRESH_BEFORE_SECONDS=300
INSPECTION_ALLCORE_VERIFY_TLS=false
