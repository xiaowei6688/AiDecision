# Inspection integration upstream API
# Keep these values beside the integration instead of the framework root .env.
INSPECTION_API_BASE_URL=
INSPECTION_API_TIMEOUT_SECONDS=30
INSPECTION_PLAN_DETAIL_URL=

# Inspection upstream authentication.
# Used only by inspection-owned upstream calls. Frontend callback actions such as
# createPlan/createTempOrder do not use these tokens in the Agent backend.
INSPECTION_AUTH_TOKEN=
INSPECTION_AUTH_LOGIN_URL=
INSPECTION_AUTH_USERNAME=
INSPECTION_AUTH_PASSWORD=
INSPECTION_AUTH_GRANT_TYPE=password
INSPECTION_AUTH_TYPE=account
INSPECTION_AUTH_SCOPE=all
INSPECTION_BASIC_AUTH=
INSPECTION_TENANT_ID=
INSPECTION_TOKEN_TTL_SECONDS=7200
INSPECTION_TOKEN_REFRESH_BEFORE_SECONDS=300
