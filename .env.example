# Runtime
APP_NAME="AI Decision Service"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database / LangGraph checkpoint storage
# Leave empty to use the in-memory checkpointer.
DATABASE_URL=
CHECKPOINT_SETUP_ON_START=true

# LLM provider
AGENT_MODEL="gpt-4o-mini"
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=60

# API / security
# JSON array, for example: ["http://localhost:3000","http://localhost:5173"]
ALLOWED_ORIGINS='["*"]'
CONFIRMATION_SECRET="change-me-in-production"
CONFIRMATION_TTL_SECONDS=600

# Integration loading.
# Empty list loads no business integrations. Use ["*"] for local discovery or list production plugins explicitly.
ENABLED_INTEGRATIONS='["inspection"]'

# External text-to-SQL service
TEXT_TO_SQL_BASE_URL=
TEXT_TO_SQL_TIMEOUT_SECONDS=30

# Conversation context compression
CONTEXT_RECENT_MESSAGES=20
CONTEXT_SUMMARY_MAX_CHARS=6000
