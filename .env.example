# Runtime
APP_NAME="AI Decision Service"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database / LangGraph checkpoint storage
# Leave empty to use the in-memory checkpointer.
DATABASE_URL=
CHECKPOINT_SETUP_ON_START=true

# LLM provider
AGENT_MODEL="gpt-4o-mini"
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=60

# API / security
# JSON array, for example: ["http://localhost:3000","http://localhost:5173"]
ALLOWED_ORIGINS='["*"]'
CONFIRMATION_SECRET="change-me-in-production"
CONFIRMATION_TTL_SECONDS=600

# User authentication for this Agent service.
# true: require caller Authorization token outside development.
# false: skip user auth and use anonymous-user / anonymous-tenant.
AUTH_ENABLED=true

# Integration loading.
# Empty list loads all discovered integrations. Set ["inspection"] to load only inspection.
ENABLED_INTEGRATIONS='[]'

# External text-to-SQL service
TEXT_TO_SQL_BASE_URL=
TEXT_TO_SQL_TIMEOUT_SECONDS=30

# Inspection integration upstream API
INSPECTION_API_BASE_URL=
INSPECTION_API_TIMEOUT_SECONDS=30
INSPECTION_PLAN_DETAIL_URL=

# Inspection upstream authentication.
# These tokens are used only when the inspection Adapter calls the old business system.
# They are separate from the user's Authorization token for this Agent service.
INSPECTION_AUTH_TOKEN=
INSPECTION_AUTH_LOGIN_URL=
INSPECTION_AUTH_USERNAME=
INSPECTION_AUTH_PASSWORD=
INSPECTION_AUTH_GRANT_TYPE=password
INSPECTION_AUTH_TYPE=account
INSPECTION_AUTH_SCOPE=all
INSPECTION_BASIC_AUTH=
INSPECTION_TENANT_ID=
INSPECTION_TOKEN_TTL_SECONDS=7200
INSPECTION_TOKEN_REFRESH_BEFORE_SECONDS=300

# Conversation context compression
CONTEXT_RECENT_MESSAGES=20
CONTEXT_SUMMARY_MAX_CHARS=6000
